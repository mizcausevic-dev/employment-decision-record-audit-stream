{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mizcausevic-dev/employment-decision-record-audit-stream/blob/main/schema/employment-decision-event.schema.json",
  "title": "Employment Decision Record Audit Event",
  "description": "Hash-chained append-only ledger event describing which AI tool (Automated Employment Decision Tool / AEDT in NYC LL 144 vocabulary) read which candidate / employee record, when, under which EEOC AI Guidance / ADA / Section 504 / Title VII / ADEA / GINA / NYC LL 144 / IL AI Video Interview Act / MD HB 1202 / state-AI-law regulatory basis, under which buyer-published Decision Card. Covers the four primary employment-AI decision surfaces — hiring (sourcing / screening / interview-scoring / offer), promotion, performance evaluation, termination — under one schema with kind enum branching. Designed to bridge HR-system semantics (Workday + UKG + Greenhouse + Lever + iCIMS) to the Kinetic Gain Protocol Suite audit-stream spine.",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "kind",
    "source",
    "subject_ref",
    "resource",
    "action",
    "outcome",
    "agent",
    "regulatory_basis",
    "decision_card_ref",
    "prev_hash",
    "hash"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id":                  {"type": "string", "minLength": 1, "description": "UUID v7 or similar monotonic ID"},
    "timestamp":                 {"type": "string", "format": "date-time"},
    "kind": {
      "type": "string",
      "enum": [
        "employment.hiring.sourcing-ranked",
        "employment.hiring.resume-screened",
        "employment.hiring.video-interview-scored",
        "employment.hiring.assessment-scored",
        "employment.hiring.recommendation-produced",
        "employment.hiring.adverse-action-evaluated",
        "employment.promotion.candidate-scored",
        "employment.promotion.recommendation-produced",
        "employment.performance.evaluation-scored",
        "employment.performance.recommendation-produced",
        "employment.termination.risk-flagged",
        "employment.termination.recommendation-produced",
        "employment.accommodation-request-evaluated",
        "employment.deletion-requested"
      ]
    },
    "source":                    {"type": "string", "minLength": 1, "description": "The system that emitted the event (e.g. 'momentumhr-workday', 'vendore-hireassess-2.x')"},
    "subject_ref": {
      "type": "object",
      "required": ["scheme", "value"],
      "additionalProperties": false,
      "properties": {
        "scheme": {"type": "string", "enum": ["candidate-id-tokenized", "employee-id-tokenized", "applicant-id-tokenized", "workday-worker-id-tokenized", "internal-tokenized"]},
        "value":  {"type": "string", "minLength": 1, "description": "Tokenized candidate / employee identifier — RAW SSN, name, DOB, email, social-media handle MUST NOT appear"}
      }
    },
    "subject_role_context": {
      "type": "string",
      "enum": ["external-candidate", "internal-candidate", "current-employee", "contingent-worker", "departing-employee"]
    },
    "resource": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type":           {"type": "string", "enum": ["resume-cv", "cover-letter", "application-form", "video-interview-recording", "video-interview-transcript", "asynchronous-interview-recording", "assessment-test-result", "skills-test-result", "background-check-report", "credit-check-report", "social-media-scrape", "reference-check-summary", "performance-review-document", "compensation-history", "time-and-attendance-record", "workforce-planning-projection", "adverse-action-notice", "reasonable-accommodation-request"]},
        "id_tokenized":   {"type": "string", "minLength": 1, "description": "Tokenized resource ID"},
        "fields_accessed":{"type": "array", "items": {"type": "string"}, "description": "Logical field names accessed (e.g. ['YearsOfExperience', 'CertificationsList'])"}
      }
    },
    "action": {
      "type": "string",
      "enum": ["C", "R", "U", "D", "E"],
      "description": "Action codes: C = Create, R = Read, U = Update, D = Delete, E = Execute"
    },
    "outcome": {
      "type": "string",
      "enum": ["0", "4", "8", "12"],
      "description": "Outcome codes: 0 = success, 4 = minor failure, 8 = serious failure, 12 = major failure"
    },
    "agent": {
      "type": "object",
      "required": ["ai_tool_card_url", "ai_decision_card_url"],
      "additionalProperties": false,
      "properties": {
        "ai_tool_card_url":     {"type": "string", "format": "uri"},
        "ai_decision_card_url": {"type": "string", "format": "uri"},
        "is_aedt_per_nyc_ll_144":{"type": "boolean", "description": "Whether this tool meets the NYC Local Law 144 'Automated Employment Decision Tool' definition (substantially assists or replaces discretionary decisions)"},
        "principal":            {"type": "string", "description": "OPTIONAL — actor on whose behalf the AI tool acted (recruiter, hiring manager, HR business partner)"}
      }
    },
    "regulatory_basis": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "eeoc-ai-guidance-may-2023",
            "nyc-local-law-144-aedt",
            "il-ai-video-interview-act-820-ilcs-42",
            "md-hb-1202-facial-recognition",
            "ca-ab-331-proposed-or-dfeh-regs",
            "co-ai-act-consequential-decision",
            "title-vii-1964",
            "ada-1990-as-amended",
            "section-504-rehab-act",
            "adea-1967",
            "gina-2008",
            "ofccp-federal-contractor-obligations",
            "candidate-explicit-opt-in-granted",
            "employee-explicit-opt-in-granted",
            "judicial-order-or-subpoena"
          ]
        },
        "citation":         {"type": "string"},
        "consent_record_uri":{"type": "string", "format": "uri"}
      }
    },
    "decision_card_ref":       {"type": "string", "format": "uri"},
    "records_of_disclosure_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logged_in_nyc_ll_144_bias_audit_record": {"type": "boolean", "description": "Whether this event is captured in the NYC LL 144 annual bias audit data set"},
        "logged_in_eeoc_recordkeeping_log":        {"type": "boolean", "description": "Whether this event is captured in the 29 CFR §1602 EEOC recordkeeping log"},
        "log_entry_uri":                           {"type": "string", "format": "uri"}
      }
    },
    "purpose_of_use":          {"type": "string", "description": "Free-text purpose statement (e.g. 'resume screening', 'video-interview scoring', 'promotion recommendation')"},
    "redaction_applied":       {"type": "array", "items": {"type": "string"}, "description": "Which fields were tokenized / hashed / redacted per the Decision Card's vault contract before reaching the AI tool"},
    "candidate_notice_provided": {
      "type": "object",
      "description": "OPTIONAL — when this event is part of an NYC LL 144 in-scope decision, the candidate-notice attestation",
      "additionalProperties": false,
      "properties": {
        "notice_provided":      {"type": "boolean"},
        "notice_uri":            {"type": "string", "format": "uri"},
        "alternative-selection-process-offered": {"type": "boolean", "description": "NYC LL 144 §20-871(b)(1)(c)"}
      }
    },
    "ai_recommendation": {
      "type": "object",
      "description": "OPTIONAL — present on *.recommendation-produced + *.scored events. Never autonomous on adverse-action — that always requires a human hiring manager / HR business partner.",
      "additionalProperties": false,
      "properties": {
        "recommendation":            {"type": "string", "enum": ["advance", "advance-with-followup", "decline", "refer-to-human", "promote", "do-not-promote", "performance-meets", "performance-exceeds", "performance-below", "terminate-recommended", "investigate-further", "no-action"]},
        "reason_codes":              {"type": "array", "items": {"type": "string"}, "description": "Reason codes per the employer's reason-code dictionary"},
        "model_version":             {"type": "string"},
        "model_confidence":          {"type": "number", "minimum": 0, "maximum": 1},
        "human_hiring_decision_required": {"type": "boolean", "description": "MUST be true on any event whose recommendation could trigger an adverse employment action (EEOC AI Guidance + NYC LL 144 + state-AI-law expectation)"}
      }
    },
    "accommodation_pathway": {
      "type": "object",
      "description": "OPTIONAL — present on accommodation-request-evaluated events",
      "additionalProperties": false,
      "properties": {
        "alternative_process_offered":     {"type": "boolean"},
        "human_reviewer_assigned":          {"type": "boolean"},
        "extended_time_provided":           {"type": "boolean"},
        "screen-reader-compatible-process": {"type": "boolean"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ip_hashed":      {"type": "string"},
        "tls_version":           {"type": "string"}
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "signer_key_uri", "signature_b64"],
      "additionalProperties": false,
      "properties": {
        "algorithm":     {"type": "string", "const": "ed25519"},
        "signer_key_uri":{"type": "string", "format": "uri"},
        "signature_b64": {"type": "string"}
      }
    },
    "prev_hash":               {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash":                    {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
